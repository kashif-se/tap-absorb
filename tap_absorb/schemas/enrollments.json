{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string"},
    "userId": {"type": ["string", "null"]},
    "courseId": {"type": ["string", "null"]},
    "courseName": {"type": ["string", "null"]},
    "courseCode": {"type": ["string", "null"]},
    "courseType": {"type": ["string", "null"]},
    "status": {
      "type": ["string", "integer", "null"],
      "description": "Enrollment status. May be returned as integer (0=notStarted, 1=inProgress, 2=complete, 3=failed) or string."
    },
    "progress": {"type": ["number", "null"], "description": "0-100 percentage"},
    "score": {"type": ["number", "null"]},
    "isPassed": {"type": ["boolean", "null"]},
    "isActive": {"type": ["boolean", "null"]},
    "dateEnrolled": {"type": ["string", "null"], "format": "date-time"},
    "dateStarted": {"type": ["string", "null"], "format": "date-time"},
    "dateCompleted": {"type": ["string", "null"], "format": "date-time"},
    "expiryDate": {"type": ["string", "null"], "format": "date-time"},
    "dateExpires": {"type": ["string", "null"], "format": "date-time"},
    "dateDue": {"type": ["string", "null"], "format": "date-time"},
    "accessDate": {"type": ["string", "null"], "format": "date-time"},
    "dateAdded": {"type": ["string", "null"], "format": "date-time"},
    "dateEdited": {"type": ["string", "null"], "format": "date-time"},
    "enrollmentKey": {"type": ["string", "null"]},
    "enrollmentKeyId": {"type": ["string", "null"]},
    "creditEarned": {"type": ["number", "null"]},
    "credits": {"type": ["number", "null"]},
    "timeSpent": {"type": ["string", "number", "null"], "description": "Duration string (HH:MM:SS) or numeric seconds"},
    "timeSpentTicks": {"type": ["string", "number", "null"]},
    "certificateId": {"type": ["string", "null"]},
    "courseVersionId": {"type": ["string", "null"]},
    "courseCollectionId": {"type": ["string", "null"]},
    "acceptedTermsAndConditions": {"type": ["boolean", "null"]},
    "fullName": {"type": ["string", "null"]},
    "jobTitle": {"type": ["string", "null"]},
    "avatar": {"type": ["string", "null"]},
    "user_id": {"type": ["string", "null"], "description": "Parent user ID (partition key injected by SDK)"}
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string"},
    "userId": {"type": ["string", "null"]},
    "name": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "provider": {"type": ["string", "null"]},
    "credits": {"type": ["number", "null"]},
    "completionDate": {"type": ["string", "null"], "format": "date-time"},
    "expiryDate": {"type": ["string", "null"], "format": "date-time"},
    "status": {"type": ["string", "null"]},
    "dateAdded": {"type": ["string", "null"], "format": "date-time"},
    "dateEdited": {"type": ["string", "null"], "format": "date-time"}
  }
}

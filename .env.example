# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.
#
# These variables are automatically picked up by:
#   - Meltano (via `meltano run` or `meltano invoke`)
#   - The Singer SDK (tap-absorb reads them natively)
#   - Any shell where you source this file

# Required
TAP_ABSORB_PRIVATE_KEY=your-private-api-key-here
TAP_ABSORB_USERNAME=api.user@yourcompany.com
TAP_ABSORB_PASSWORD=your-admin-password-here

# Optional
TAP_ABSORB_BASE_URL=https://rest.myabsorb.com
TAP_ABSORB_START_DATE=2022-01-01T00:00:00Z
TAP_ABSORB_PAGE_SIZE=500
